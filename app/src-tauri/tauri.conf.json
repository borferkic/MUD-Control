{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUD Control",
  "version": "2.0.0",
  "identifier": "io.github.borferkic.mudcontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MUD Control",
        "width": 780,
        "height": 660,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Boris SdK",
    "copyright": "© 2026 Boris SdK. Apache-2.0. Basado en RDP Wrapper Library (Stas'M Corp.)",
    "category": "Utility",
    "shortDescription": "Varias personas conectadas a la vez por Escritorio remoto",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
