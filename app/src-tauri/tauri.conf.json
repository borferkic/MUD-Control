{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUD Control",
  "version": "2.2.0",
  "identifier": "io.github.borferkic.mudcontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MUD Control",
        "width": 780,
        "height": 660,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Boris SdK",
    "copyright": "© 2026 Boris SdK. Apache-2.0. Basado en RDP Wrapper Library (Stas'M Corp.)",
    "category": "Utility",
    "shortDescription": "Varias personas conectadas a la vez por Escritorio remoto",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NzFBMDc1QTFBRkU3Q0QKUldUTjU2K2hkYUJ4Q1BDSm5jM1ZwV3IvcFlwZGYwc0VtK3h2MDk2MG5EbGVFYXFYelgxdXFpdGgK",
      "endpoints": [
        "https://github.com/borferkic/MUD-Control/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
